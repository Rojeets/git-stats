{
  "name": "@rojeets/git-stats",
  "version": "0.3.0",
  "description": "Fetch public GitHub and GitLab contribution data and compute activity statistics (totals, streaks, best day). Includes presentational React UI components (heatmap, stats summary).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "github",
    "gitlab",
    "contributions",
    "heatmap",
    "stats",
    "streak"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rojeets/git-stats.git"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jest": "^29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}
