{
  "name": "@rojeets/git-stats",
  "version": "0.1.0",
  "description": "Fetch public GitHub and GitLab contribution data and compute activity statistics (totals, streaks, best day).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "github",
    "gitlab",
    "contributions",
    "heatmap",
    "stats",
    "streak"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rojeets/git-stats.git"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^20",
    "jest": "^29",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}
